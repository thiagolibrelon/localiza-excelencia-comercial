# Dados de clientes — não subir
dados/
*.json
para_gpt.txt

# Script de descompactação utilitário
scripts/Descompac.py

# Credenciais locais
.env

# Resultados de análise (gerados localmente)
resultados/gemini/
resultados/gemini_v2/
resultados/gemini_novo_lote/
resultados/gemini_ligacoes_diarias/
resultados/erros/
resultados_analise/

# Pipeline diario de ligacoes: os JSONs de entrada/analisado sao subidos pro
# Git (excecao pontual a regra "*.json" acima), so os brutos com PII ficam
# fora (cobertos pela regra "dados/" acima)
!dados_ligacoes_diarias/**/*.json

# Pasta JULHO: brutos com PII (transcricoes reais) + convertidos + saida Gemini —
# mesma logica de "dados/" acima, so o plano/log ficam versionados
JULHO/*.2
JULHO/arq*.txt
JULHO/dados_convertidos/
JULHO/resultados_gemini/
JULHO/log_execucao.txt

# Pasta chamadas/<mes>/: brutos com PII (transcricoes reais), mesma logica
# de "dados/" acima — nao subir
chamadas/

# Pacote RMR extraido do zip (CSV bruto de 15k ligacoes com PII + previews) —
# nao subir
_pacote_rmr/

# experimento_gemini_gpt_amostra50/: scripts (.py) e README ficam
# versionados, dados com transcricao/PII/derivados nao (mesma logica de
# dados/ acima)
experimento_gemini_gpt_amostra50/amostra_50.json
experimento_gemini_gpt_amostra50/gemini/
experimento_gemini_gpt_amostra50/gpt/
experimento_gemini_gpt_amostra50/comparacao/

# Amostras geradas localmente
amostras/

# Imagens de referência
auxiliares/

# Cache do Python
__pycache__/
*.pyc
